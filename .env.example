DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/career_platform
TEST_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM
LLM_PROVIDER=stub
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_ORDER=gemini,groq,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OLLAMA_URL=
OLLAMA_MODEL=
LLM_TIMEOUT=60
LLM_RETRIES=3

# CV / OCR
CV_UPLOAD_DIR=./uploads/cv
CV_MAX_UPLOAD_SIZE_BYTES=5242880
OCR_ENABLED=true
OCR_MIN_CHARS=80
OCR_TIMEOUT_SECONDS=60
PROMPTS_DIR=../prompts

# Embeddings / FAISS
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_USE_STUB=true
FAISS_INDEX_DIR=./data/faiss
SIMILARITY_TOP_K=10
RETRIEVAL_TOP_K=5
RERANK_ENABLED=false

# Adzuna
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_COUNTRY=gb
# true = offline corpus (includes North Macedonia mock jobs for local-market demos)
# false = live Adzuna for supported markets (e.g. gb); MK is not an Adzuna country
ADZUNA_USE_MOCK=true
ADZUNA_CACHE_TTL_SECONDS=3600
ADZUNA_MONTHLY_BUDGET=250

# Learning resources
SERPAPI_API_KEY=

# Feature flags
ENABLE_CV_LLM_PARSE=true
ENABLE_ATS_SCORING=true
ENABLE_AUTO_EMBED=true

# Auth / JWT
JWT_SECRET=skillbridge-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
