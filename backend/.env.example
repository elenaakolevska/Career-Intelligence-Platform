# Backend environment variables example
# Copy this file to .env and fill in provider keys as needed.

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/career_platform
# Optional override used by tests
TEST_DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# CORS origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM configuration
# Provider choice: stub, gemini, groq, ollama
LLM_PROVIDER=stub
# Fallback can walk through the providers in order when a transient provider error occurs.
LLM_FALLBACK_ENABLED=true
# JSON array or comma-separated list. Default chain: gemini -> groq -> ollama.
LLM_FALLBACK_ORDER=["gemini","groq","ollama"]

# --- Gemini (primary) ---
# To use Gemini (Google Generative), set the API key below.
# GEMINI_API_KEY is required for real requests. Keep this secret.
GEMINI_API_KEY=
# Model to use (default is gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Base API URL (usually not changed)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1

# --- Groq (optional) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_URL=https://api.groq.com/openai/v1

# --- Ollama (local fallback) ---
# If running Ollama locally, set the base URL and model name.
# OLLAMA_URL should be None or empty if you don't run Ollama locally.
OLLAMA_URL=
OLLAMA_MODEL=

# Client tuning
LLM_TIMEOUT=60
LLM_RETRIES=3

# Do not commit real API keys to version control.
